# wagent skill — example configuration file.
#
# Usage:
#   1. Copy this file to `.env` (in the same directory as SKILL.md).
#   2. Uncomment and fill in only what you need.
#   3. Run `python3 scripts/discover.py` / `scripts/buy.py` — both auto-load `.env`.
#
# Precedence: shell env > .env > baked-in defaults. Setting a var in your
# shell (`export FOO=…`) always wins over the same var in this file.
#
# Note: `.env` is git-ignored. NEVER commit a filled-in copy.


# ─── W Connector gateway ──────────────────────────────────────────────────
# Where the registry and order machine live. Defaults to dev.
# CONNECTOR_URL=https://connector-dev.wcheckout.app    # dev (default)
# CONNECTOR_URL=https://connector.wcheckout.app        # prod


# ─── Wallet backend ───────────────────────────────────────────────────────
# `local` for test/dev (Sepolia, free) — recommended for first run.
# `okx`   for production (mainnet, MPC custody + Policy controls).
# PAYMENT_BACKEND=local


# ─── Local backend (only when PAYMENT_BACKEND=local) ──────────────────────
# LOCAL_NETWORK=sepolia                                # sepolia (default) | mainnet
# AGENT_WALLET_PRIVATE_KEY=0x<your_64_hex>             # generate: python3 -c "import secrets; print('0x'+secrets.token_hex(32))"
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>
# MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>


# ─── OKX backend (only when PAYMENT_BACKEND=okx) ──────────────────────────
# OKX_NETWORK=base                                     # base (default) | ethereum | bsc | arbitrum | polygon
# OKX_API_KEY=oak_xxxxxxxxxxxxxxxx                     # OR run `onchainos wallet login <email>` instead
# OKX_TOKEN_CONTRACT=                                  # optional — overrides chain's default USDC


# ─── Token contract overrides (rare — defaults are canonical) ─────────────
# ETH_USDC_CONTRACT=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48      # mainnet
# ETH_WUSD_CONTRACT=0x7Cd017ca5ddb86861FA983a34b5F495C6F898c41      # mainnet
# ETH_USDT_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7      # mainnet
# ETH_USDT_CONTRACT_SEPOLIA=                                         # Sepolia has no canonical USDT
